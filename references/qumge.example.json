{
  "qumge": "2",
  "connections": {
    "reporter": {
      "type": "api",
      "base_url": "https://api.example.com",
      "auth": "api_key"
    }
  },
  "capabilities": [
    {
      "slug": "row-summary",
      "name": "Row summary",
      "summary": "Numbers in, count and sum out.",
      "icon_url": "https://api.example.com/icon.png",
      "connection": "reporter",
      "operations": [
        {
          "name": "summarize_rows",
          "method": "POST",
          "path": "/summary",
          "description": "Summarize numbers.",
          "price_usd": 0.01,
          "input_schema": {
            "type": "object",
            "required": [
              "values"
            ],
            "additionalProperties": false,
            "properties": {
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "output_schema": {
            "type": "object",
            "required": [
              "count",
              "sum"
            ],
            "additionalProperties": false,
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "sum": {
                "type": "number"
              }
            }
          },
          "example_input": {
            "values": [
              2,
              3,
              5
            ]
          },
          "example_output": {
            "count": 3,
            "sum": 10
          },
          "execution": {
            "mode": "sync",
            "protocol": "native",
            "identity": "order",
            "idempotency": {
              "mode": "none"
            },
            "completion_timeout_seconds": 30
          }
        }
      ]
    }
  ],
  "$schema": "https://qumge.com/schemas/qumge-manifest/v2.json"
}
